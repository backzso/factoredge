# Copy to .env (same folder) and fill in. .env is git-ignored.
# docker compose, the backend and the Prisma CLI all read this single file.

# --- Postgres container (docker compose) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
# Main database, created on the first container start.
POSTGRES_DB=factoredge

# --- Backend ---
# Must match the POSTGRES_* values above. URL-encode special characters in the password.
# Format: postgresql://<user>:<password>@localhost:5432/factoredge
DATABASE_URL=
# Used only by the e2e tests. The database name must end with "_test";
# factoredge_test is created by docker/postgres/init on the first container start.
# Format: postgresql://<user>:<password>@localhost:5432/factoredge_test
TEST_DATABASE_URL=

# HMAC secret for signing JWTs, at least 32 characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET=
# Token and cookie lifetime: a number followed by s, m, h or d (e.g. 15m, 8h, 1d).
JWT_EXPIRES_IN=8h

# HTTP port of the backend.
PORT=3000
# development | production | test. In production the auth cookie is sent with the Secure flag.
NODE_ENV=development

# --- Seed only (npm run db:seed) ---
# Creates this ADMIN user only when the users table is empty.
# Username: 3-32 chars of letters, digits, "_", "." or "-". Password: 8-72 bytes.
ADMIN_USERNAME=
ADMIN_PASSWORD=
